*.jpg
*.jpeg
*.png
*.bmp
*.tif
*.tiff
*.webp
*.dcm
*.nii
*.nii.gz

# Generated Clinical Audit Artifacts & Output Ledgers
audit_outputs/
audit_outputs/**
*.csv
*.json
*.tsv
*.xlsx
*.parquet

# Python Environment & Bytecode
